# StockSentinel Environment Configuration

# Telegram Approval Gate (Required for Telegram bot)
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Optional: restrict bot alerts to your specific chat ID, or leave empty to auto-detect on /start
TELEGRAM_CHAT_ID=

# Epsilon Local LLM Engine (Qwen 2.5 7B)
EPSILON_ENGINE_PATH=./engine
EPSILON_TIER=balanced
EPSILON_TIMEOUT_MS=60000

# Pipeline Configuration
POLL_INTERVAL_SEC=30
PORT=3000

# Paper Trading Target URL
PAPER_TRADING_URL=https://www.tradingview.com/chart/
